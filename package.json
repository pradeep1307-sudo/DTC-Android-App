{
  "name": "denver-tamil-church-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Denver Tamil Church mobile app for Android",
  "scripts": {
    "sync:web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-web.ps1",
    "sync": "npm run sync:web && cap sync",
    "android": "npm run sync && cap open android",
    "android:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-release.ps1",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
